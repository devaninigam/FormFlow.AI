# Dependencies
node_modules/
.pnp/
.pnp.js

# Production / Vite build outputs
dist/
dist-ssr/
*.local

# Environment & Secrets (NEVER commit real API keys or credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Runtime Document Storage (Keep directory structure with .gitkeep, ignore runtime files)
storage/uploads/*
!storage/uploads/.gitkeep
storage/processed/*
!storage/processed/.gitkeep

# Tesseract offline trained models (downloaded on demand or cached locally)
eng.traineddata
*.traineddata

# Scratchpad, debug crops, and local inspection scripts
scratch/
test_*.docx
test_*.xlsx
test_*.pdf

# Template test generated outputs (keep original templates)
templates/test_*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

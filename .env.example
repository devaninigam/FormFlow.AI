# FormFlow AI Configuration

# Server Port
PORT=5000

# Optional: Azure AI Document Intelligence Credentials
# Used for enterprise layout analysis, table recognition, and handwriting extraction
# Pricing: Free tier (500 pages/mo) or Standard S0 ($1.50 per 1,000 pages)
# Portal: https://portal.azure.com -> Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# Optional: Secondary Vision-Language Model (Gemini Vision)
# Used for difficult handwriting, unconstrained layouts, and complex forms
# Free tier available: https://aistudio.google.com
GEMINI_API_KEY=

# Optional: Secondary Vision-Language Model (OpenAI Vision)
# Used for GPT-4o vision verification
OPENAI_API_KEY=

# Note: If no external API keys are provided, FormFlow AI automatically operates
# using its built-in Smart Local Engine (Sharp + Tesseract + CV Layout Analysis)
# with 100% offline capability and zero subscription fees.
